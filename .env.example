# =========================================================
# 数据库（本地 PostgreSQL，conda 环境 SggYourSpecialJobPG，trust 本地认证）
# =========================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=yourspecialjob

# =========================================================
# 模型配置（强/弱/备用 + embedding，均为 OpenAI 兼容接口）
# 强模型：主 agent 推理与推荐排序
# 弱模型：结构化提取 / 偏好提取 / 截图解析（需支持多模态）
# 备用模型：主模型失败时 fallback
# =========================================================
STRONG_MODEL=glm-5.1
STRONG_API_KEY=
STRONG_BASE_URL=

WEAK_MODEL=glm-4.5-air
WEAK_API_KEY=
WEAK_BASE_URL=

BACKUP_MODEL=deepseek-v4-flash
BACKUP_API_KEY=
BACKUP_BASE_URL=

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMS=1024

# =========================================================
# 高德开放平台（注意两种 key 类型不同，都在同一个控制台申请）
# AMAP_SERVER_KEY：Web服务类型 key（后端 MCP server @amap/amap-maps 使用）
#   也兼容 AMAP_MAPS_API_KEY 变量名（二者填其一即可，AMAP_SERVER_KEY 为空时自动回填）
# AMAP_JS_KEY / AMAP_SECURITY_CODE：Web端(JS API)类型 key + 安全密钥（前端地图使用）
# =========================================================
AMAP_SERVER_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# =========================================================
# 微信 MCP（PC 微信 UI 自动化，仅 Windows + 微信桌面端常驻）
# WECHAT_SENDER_ID：希望 agent 发送消息的目标微信 id（默认填自己的微信 id）
# =========================================================
WECHAT_SENDER_ID=
